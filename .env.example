# `id -u` / `id -g`
NAPCAT_UID=501
NAPCAT_GID=20

# NapCat WebUI 登录 token。只在首次启动（data/napcat/config/webui.json 不存在）时写入。
NAPCAT_WEBUI_TOKEN=change-me

# bot 的 QQ 号。首次扫码登录后填上，之后重启走快速登录。
NAPCAT_ACCOUNT=

# NapCat 容器的主机名和 MAC，QQ 拿它们认设备。第一次 make up 前随便定一个（MAC 用 02: 开头的本地地址），之后别改。
NAPCAT_HOSTNAME=
NAPCAT_MAC=

NAPCAT_WEBUI_PORT=6099
ASTRBOT_WEBUI_PORT=6185

# 1 = 插件热重载（轮询 data/astrbot/plugins），写插件时打开，改完 `make up` 生效。
ASTRBOT_RELOAD=0
